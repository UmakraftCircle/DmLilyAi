# --- Required for real replies / Discord ---
GROQ_API_KEY=
DISCORD_TOKEN=

# --- API + console security (REQUIRED when the API is reachable from the internet) ---
ADMIN_TOKEN=
CORS_ORIGINS=                  # leave empty: the website is served by the bot itself (same URL)

# --- Models (free-tier Groq models) ---
LILYAI_CHAT_MODEL=openai/gpt-oss-20b
LILYAI_REASONING_MODEL=openai/gpt-oss-120b

# --- Behaviour ---
ALLOWED_USER_IDS=              # comma-separated Discord user ids; empty = anyone who can DM the bot
HISTORY_TURNS=12
TOKEN_BUDGET=6000
WEB_ENABLED=true
LEARN_FROM_CHATS=true

# --- Runtime ---
FRONTEND_DIR=                  # default: LilyAiFrontend/ next to the code
ENABLE_DISCORD=true
ENABLE_API=true
API_HOST=0.0.0.0
PORT=8000
LILYAI_DATA_DIR=./data
LOG_LEVEL=INFO

# --- Scheduled Groq model scan (probes new models, adds passing ones to the pool, writes LilyAiGroqSupport/MODEL_CATALOG.md)
MODEL_SCAN_ENABLED=true
MODEL_SCAN_INTERVAL_HOURS=24
MODEL_SCAN_MAX_AUTO=6          # cap on auto-added models
MODEL_SCAN_DOCS_DIR=           # default: LilyAiGroqSupport/ (falls back to the data dir if not writable)
