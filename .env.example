# --- Required for real replies / Discord ---
GROQ_API_KEY=                  # one key, or several comma-separated (e.g. gsk_a,gsk_b,gsk_c) - rotated evenly, auto-switches on rate limits
DISCORD_TOKEN=

# --- API + console security (REQUIRED when the API is reachable from the internet) ---
ADMIN_TOKEN=
CORS_ORIGINS=                  # leave empty: the website is served by the bot itself (same URL)

# --- Models (free-tier Groq models) ---
LILYAI_CHAT_MODEL=openai/gpt-oss-20b
LILYAI_REASONING_MODEL=openai/gpt-oss-120b

# --- Behaviour ---
ALLOWED_USER_IDS=              # comma-separated Discord user ids; empty = anyone who can DM the bot
HISTORY_TURNS=12
TOKEN_BUDGET=6000
WEB_ENABLED=true
LEARN_FROM_CHATS=true

# --- Runtime ---
FRONTEND_DIR=                  # default: LilyAiFrontend/ next to the code
ENABLE_DISCORD=true
ENABLE_API=true
API_HOST=0.0.0.0
PORT=8000
LILYAI_DATA_DIR=./data
LOG_LEVEL=INFO

# --- Scheduled Groq model scan (probes new models, adds passing ones to the pool, writes LilyAiGroqSupport/MODEL_CATALOG.md)
MODEL_SCAN_ENABLED=true
MODEL_SCAN_INTERVAL_HOURS=24
MODEL_SCAN_MAX_AUTO=6          # cap on auto-added models
MODEL_SCAN_DOCS_DIR=           # default: LilyAiGroqSupport/ (falls back to the data dir if not writable)

# --- Ops-alert webhook (optional) ---
WEBHOOK_URL=                   # Discord/Slack-compatible {"content": ...} POST endpoint. Fired on API/Discord task
                                # crashes and scheduled-job failures. Empty = disabled (failures still get logged).

# --- uma.moe circle/fan tracking (optional; powers the Leaderboard page + check_umamoe tool) ---
UMAMOE_API_KEY=                # from https://uma.moe - required for every endpoint except /health and /ver
UMAMOE_CIRCLE_IDS=             # comma-separated circle ids to track (e.g. your 2 clubs: 12345,67890)
UMAMOE_NOTIFY_USER_ID=         # Discord user id to DM on rank/points/fan changes; empty = log only, no DM
UMAMOE_POLL_INTERVAL_HOURS=6
UMAMOE_POLL_INTERVAL_SECONDS=300  # overrides the hours setting when set (300 = every 5 minutes); 60s floor enforced

# --- Turso (libSQL) database (optional) ---
# When TURSO_DATABASE_URL is set, LilyAi stores memory/state in Turso instead of local sqlite
# (see LilyAiCore/ExternalServices/Database/turso.py). Useful on hosts with an ephemeral
# filesystem (e.g. Render's free plan) since the data then survives redeploys/restarts.
TURSO_DATABASE_URL=            # e.g. libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=              # from `turso db tokens create <db-name>`
TURSO_SYNC_INTERVAL_SECONDS=60 # background sync interval for the local embedded replica

# --- Self-ping (optional, on by default) ---
# Pings this service's own /api/health every SELF_PING_INTERVAL_SECONDS so a free-tier host
# (e.g. Render's free plan, which sleeps a web service after ~15 min of no inbound traffic)
# stays awake. On Render, SELF_PING_URL is not needed - it defaults to the auto-set
# RENDER_EXTERNAL_URL. Set SELF_PING_URL explicitly for other hosts, or SELF_PING_ENABLED=false
# to turn it off. See LilyAiMain/MainService/Interaction/Workflows/self_ping_job.py.
SELF_PING_ENABLED=true
SELF_PING_URL=                 # defaults to $RENDER_EXTERNAL_URL on Render; set explicitly elsewhere
SELF_PING_INTERVAL_SECONDS=300 # 5 minutes; 60s floor enforced
